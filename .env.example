# Supabase project (API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection (Shared Pooler example)
# Replace YOUR-PASSWORD; percent-encode special characters if needed.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR-PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres

# Milestone 3+
YOUTUBE_API_KEY=
OPENROUTER_API_KEY=
# Example: openai/text-embedding-3-large (request dimensions: 2048)
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-large

#Openrouter API key connection:
OPENROUTER_API_KEY=
