# Supabase project (API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection (Shared Pooler example)
# Replace YOUR-PASSWORD; percent-encode special characters if needed.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR-PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres

# Ingest + embed
YOUTUBE_API_KEY=
OPENROUTER_API_KEY=
# Must match videos.embedding vector size (currently 1586)
OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
